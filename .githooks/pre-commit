#!/bin/sh
echo "Running staged secret scan..."
# Exclude google-services.json and GoogleService-Info.plist — Firebase API keys
# in these files are intentionally public (security is via Firebase Rules, not key secrecy).
if git diff --cached -- . \
  ':!*google-services.json' ':!*GoogleService-Info.plist' \
  | grep -E "ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{20,}|AIza[0-9A-Za-z_-]{35}|-----BEGIN (RSA |EC |OPENSSH |)?PRIVATE KEY-----|xox[baprs]-[A-Za-z0-9-]+" >/dev/null; then
  echo "Commit blocked: potential secret found in staged changes."
  exit 1
fi
exit 0
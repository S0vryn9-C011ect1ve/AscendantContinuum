{
    "name": "ascendant-continuum-social",
    "version": "1.0.0",
    "description": "Automated social media content system for Ascendant Continuum Game",
    "type": "module",
    "scripts": {
        "social:post": "node scripts/automation/content-scheduler.js",
        "social:dev-update": "node scripts/content/dev-update-generator.js",
        "social:test-bluesky": "node scripts/posting/post-to-bluesky.js",
        "social:test-mastodon": "node scripts/posting/post-to-mastodon.js",
        "social:test-discord": "node scripts/posting/post-to-discord.js",
        "social:test-all": "DRY_RUN=true node scripts/automation/content-scheduler.js",
        "social:analytics": "node scripts/analytics/social-analytics.js",
        "social:dashboard": "node scripts/analytics/generate-dashboard.js",
        "content:build-bank": "node scripts/content/build-content-bank.js",
        "content:philosophy": "node scripts/content/design-philosophy-generator.js",
        "content:behind-scenes": "node scripts/content/behind-scenes-generator.js",
        "content:lore": "node scripts/content/lore-snippet-generator.js",
        "content:education": "node scripts/content/dev-education-generator.js",
        "security:audit": "npm audit",
        "security:audit-fix": "npm audit fix",
        "security:check-axios": "npm list axios",
        "security:full-scan": "npm audit && npm list axios && npm outdated",
        "security:weekly": "node scripts/security/security-scan.js",
        "security:socket": "echo 'Socket.dev GitHub App: ACTIVE (real-time protection on all commits)' && echo 'Socket CLI: Known issues on Windows with Nodist - not needed' && echo 'Your protection: Socket GitHub App + 7-day delay = Maximum security'",
        "safe-install": "npm ci",
        "safe-add": "npm install --min-release-age=7",
        "validate:links": "node scripts/validation/link-checker.js https://ascendant-continuum.web.app/ https://ascendant-continuum.web.app/blog/",
        "validate:content": "node scripts/validation/content-validator.js",
        "validate:dedup": "node scripts/validation/dedup-checker.js --audit",
        "validate:backfill": "node scripts/validation/dedup-checker.js --backfill",
        "content:generate-all": "node scripts/content/generate-full-content.js",
        "content:generate-dry": "node scripts/content/generate-full-content.js --dry-run",
        "audit:content-bank": "node scripts/audit/audit-content-bank.js",
        "audit:blog-consistency": "node scripts/audit/check-blog-consistency.js",
        "audit:rewrite": "node scripts/audit/rewrite-content-bank.js --dry-run",
        "audit:rewrite-live": "node scripts/audit/rewrite-content-bank.js",
        "whatsnew:generate": "node scripts/automation/generate-whatsnew.js",
        "whatsnew:dry-run": "node scripts/automation/generate-whatsnew.js --dry-run",
        "whatsnew:force": "node scripts/automation/generate-whatsnew.js --force",
        "whatsnew:weekly": "node scripts/automation/generate-weekly.js",
        "whatsnew:weekly-dry": "node scripts/automation/generate-weekly.js --dry-run",
        "whatsnew:weekly-force": "node scripts/automation/generate-weekly.js --force"
    },
    "dependencies": {
        "@atproto/api": "^0.12.0",
        "dotenv": "^16.4.5",
        "megalodon": "^10.3.0",
        "node-fetch": "^3.3.2"
    },
    "overrides": {
        "axios": ">=1.13.5",
        "uuid": ">=14.0.0",
        "gaxios": ">=6.7.1",
        "@tootallnate/once": "^3.0.1",
        "http-proxy-agent": "^7.0.0",
        "fast-xml-parser": ">=5.5.7",
        "flatted": ">=3.4.2"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
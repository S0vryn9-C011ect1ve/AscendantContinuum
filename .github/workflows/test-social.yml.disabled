name: Test Social Media Posting

# Manual workflow for testing social media posting
# Use this to verify credentials and posting functionality

on:
  workflow_dispatch:
    inputs:
      platform:
        description: 'Platform to test'
        required: true
        default: 'both'
        type: choice
        options:
          - both
          - bluesky
          - mastodon
      message:
        description: 'Test message (optional, uses default if empty)'
        required: false
        default: ''

permissions:
  contents: read

jobs:
  test-posting:
    runs-on: ubuntu-latest
    
    steps:
      - name: Checkout code
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683  # v4.2.2
      
      - name: Setup Node.js
        uses: actions/setup-node@39370e3970a6d050c480ffad4ff0ed4d3fdee5af  # v4.1.0
        with:
          node-version: '20'
          cache: 'npm'
      
      - name: Install dependencies
        run: npm ci
      
      - name: Test Bluesky posting
        if: inputs.platform == 'bluesky' || inputs.platform == 'both'
        env:
          BLUESKY_IDENTIFIER: ${{ secrets.BLUESKY_IDENTIFIER }}
          BLUESKY_PASSWORD: ${{ secrets.BLUESKY_PASSWORD }}
        run: node scripts/posting/post-to-bluesky.js
      
      - name: Test Mastodon posting
        if: inputs.platform == 'mastodon' || inputs.platform == 'both'
        env:
          MASTODON_INSTANCE: ${{ secrets.MASTODON_INSTANCE }}
          MASTODON_ACCESS_TOKEN: ${{ secrets.MASTODON_ACCESS_TOKEN }}
        run: node scripts/posting/post-to-mastodon.js
      
      - name: Test Summary
        run: |
          echo "✅ Test completed successfully!"
          echo "Platform: ${{ inputs.platform }}"
          echo "Check your social media accounts for test posts."

# NPM Configuration for Firebase Functions Security

# Enable audit during install
audit=true

# Audit level
audit-level=high

# Save exact versions
save-exact=true

# Use only https registry
registry=https://registry.npmjs.org/

# Keep package-lock strict
package-lock=true

# 🔒 CRITICAL: Wait 7 days before installing new packages
# Protects against supply chain attacks
min-release-age=7

# 🔒 CRITICAL: Disable install scripts by default
ignore-scripts=true

# Update notifier
update-notifier=true

# Allow legacy peer deps for Firebase compatibility
legacy-peer-deps=false

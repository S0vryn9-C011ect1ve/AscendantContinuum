rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Ritual replay videos
    match /replays/{userId}/{replayId} {
      allow read: if true; // Public (shareable)
      allow write: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Personal sigil images
    match /sigils/{userId}/{sigilId} {
      allow read: if true; // Public (shareable)
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Asset bundles (realm downloads)
    match /bundles/{bundleName} {
      allow read: if true; // Public
      allow write: if false; // Only admin can upload
    }
  }
}

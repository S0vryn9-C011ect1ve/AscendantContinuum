# NPM Configuration for Security

# Enable audit during install (default: true)
audit=true

# Audit level (info, low, moderate, high, critical)
audit-level=high

# Save exact versions (prevents unexpected updates)
save-exact=true

# Don't modify package-lock.json unless intended
package-lock=true

# 🔒 CRITICAL: Wait 7 days before installing new packages
# Protects against supply chain attacks like axios, LiteLLM, LofyGang
# Requires npm >= 11.10.0
min-release-age=7

# 🔒 CRITICAL: Disable install scripts by default
# Prevents malicious code execution during npm install
ignore-scripts=true

# Verify signatures when available
# Note: npm provenance is still rolling out
# audit-signatures=true

# Use only https registry
registry=https://registry.npmjs.org/

# Disable scripts by default (reenable per-project if needed)
# Protects against malicious install scripts
# ignore-scripts=false

# Update notifier
update-notifier=true

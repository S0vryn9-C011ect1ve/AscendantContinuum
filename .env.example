# ──────────────────────────────────────────────────────────────
# Ascendant Continuum — Android Build Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file to .env (git-ignored) and fill in real values,
# OR set these as CI/CD secrets (GitHub Actions / Bitrise / etc.)
#
# NEVER commit the real values to source control.
# ──────────────────────────────────────────────────────────────

# ── Android keystore signing (required for Play Store upload) ─
#    Leave ANDROID_KEYSTORE_PATH empty to use the debug keystore
#    for local/sideload builds.

ANDROID_KEYSTORE_PATH=path/to/your/release.keystore
ANDROID_KEYSTORE_PASS=your_keystore_password
ANDROID_KEY_ALIAS=your_key_alias
ANDROID_KEY_ALIAS_PASS=your_key_alias_password

# ── Build output format ───────────────────────────────────────
#    ANDROID_BUILD_AAB=1  → builds .aab  (Play Store submission)
#    ANDROID_BUILD_AAB=0  → builds .apk  (sideload / QA)

ANDROID_BUILD_AAB=0

# ── CI build number (auto-increment in CI pipelines) ─────────
#    Injected by Build.ps1 or your CI runner.

ANDROID_BUILD_NUMBER=1

# ── Example GitHub Actions usage ─────────────────────────────
#    env:
#      ANDROID_KEYSTORE_PATH: ${{ secrets.ANDROID_KEYSTORE_PATH }}
#      ANDROID_KEYSTORE_PASS: ${{ secrets.ANDROID_KEYSTORE_PASS }}
#      ANDROID_KEY_ALIAS:     ${{ secrets.ANDROID_KEY_ALIAS }}
#      ANDROID_KEY_ALIAS_PASS: ${{ secrets.ANDROID_KEY_ALIAS_PASS }}
#      ANDROID_BUILD_AAB:     "1"
#      ANDROID_BUILD_NUMBER:  ${{ github.run_number }}

# ──────────────────────────────────────────────────────────────
# Social Media Automation — API Credentials
# ──────────────────────────────────────────────────────────────
# For automated posting to Bluesky and Mastodon

# ── Bluesky (ATP Protocol) ───────────────────────────────────
BLUESKY_IDENTIFIER=your-handle.bsky.social
BLUESKY_PASSWORD=your-app-password

# ── Mastodon ─────────────────────────────────────────────────
MASTODON_INSTANCE=https://mastodon.social
MASTODON_ACCESS_TOKEN=your-access-token

# ── Discord Webhook (for announcements channel) ───────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ── Configuration ─────────────────────────────────────────────
DRY_RUN=false  # Set to 'true' to test without actually posting

# ── GitHub Actions usage ─────────────────────────────────────
#    env:
#      BLUESKY_IDENTIFIER: ${{ secrets.BLUESKY_IDENTIFIER }}
#      BLUESKY_PASSWORD: ${{ secrets.BLUESKY_PASSWORD }}
#      MASTODON_INSTANCE: ${{ secrets.MASTODON_INSTANCE }}
#      MASTODON_ACCESS_TOKEN: ${{ secrets.MASTODON_ACCESS_TOKEN }}
#      DISCORD_WEBHOOK_URL: ${{ secrets.DISCORD_WEBHOOK_URL }}
#      DRY_RUN: 'false'
